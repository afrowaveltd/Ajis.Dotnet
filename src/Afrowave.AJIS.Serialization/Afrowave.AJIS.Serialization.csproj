<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Afrowave.AJIS.Serialization</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ajis</Authors>
    <Description>Serialization library for Ajis framework</Description>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ajis/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ajis/dotnet</RepositoryUrl>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Afrowave.AJIS.Core\Afrowave.AJIS.Core.csproj" />
    <ProjectReference Include="..\Afrowave.AJIS.Streaming\Afrowave.AJIS.Streaming.csproj" />
  </ItemGroup>

  <ItemGroup>

    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
