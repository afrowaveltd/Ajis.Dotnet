<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Afrowave.AJIS.Net</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ajis</Authors>
    <Description>NET library for Ajis framework</Description>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ajis/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ajis/dotnet</RepositoryUrl>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Afrowave.AJIS.Core/Afrowave.AJIS.Core.csproj" />
    <ProjectReference Include="..\Afrowave.AJIS.Serialization\Afrowave.AJIS.Serialization.csproj" />
    <ProjectReference Include="..\Afrowave.AJIS.IO\Afrowave.AJIS.IO.csproj" />
  </ItemGroup>

  <ItemGroup>

    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
