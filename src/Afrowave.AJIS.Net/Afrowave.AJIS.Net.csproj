<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Afrowave.AJIS.Net</PackageId>
    <Version>1.1.0</Version>
    <Authors>Ajis</Authors>
    <PackageReleaseNotes>
## v1.1.0 (2026-02-16)

### New Features
- ASP.NET Core formatters now work with new Ajis static API
- Integration with new Ajis static API from Afrowave.AJIS.Core v1.1.0

### Dependencies
- Afrowave.AJIS.Core v1.1.0

### Notes
- No breaking changes in this release
</PackageReleaseNotes>
    <Description>NET library for Ajis framework</Description>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/afrowaveltd/Ajis.Dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/afrowaveltd/Ajis.Dotnet</RepositoryUrl>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconMetadata>icon.png</PackageIconMetadata>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Afrowave.AJIS.Core/Afrowave.AJIS.Core.csproj" />
    <ProjectReference Include="..\Afrowave.AJIS.Serialization\Afrowave.AJIS.Serialization.csproj" />
    <ProjectReference Include="..\Afrowave.AJIS.IO\Afrowave.AJIS.IO.csproj" />
  </ItemGroup>

  <ItemGroup>

    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
