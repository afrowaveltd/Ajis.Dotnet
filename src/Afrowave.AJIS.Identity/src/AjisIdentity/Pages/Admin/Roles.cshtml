@page
@model AjisIdentity.Pages.Admin.RolesModel
@{
    ViewData["Title"] = "Manage Roles";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Role</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Role Name</th>
            <th>Users</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var role in Model.Roles) {
        <tr>
            <td>@role.Name</td>
            <td>@role.UserNames.Count</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@role.Id" class="btn btn-sm btn-secondary">Edit</a>
                <a asp-page="./Delete" asp-route-id="@role.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
