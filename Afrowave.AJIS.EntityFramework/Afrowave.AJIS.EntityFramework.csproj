<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Afrowave.AJIS.EntityFramework</PackageId>
    <Version>1.1.0</Version>
    <Authors>Ajis</Authors>
    <PackageReleaseNotes>
## v1.1.0 (2026-02-16)

### New Features
- EF Core value converters now work with new Ajis static API
- Integration with new Ajis static API from Afrowave.AJIS.Core v1.1.0

### Dependencies
- Afrowave.AJIS.Core v1.1.0

### Notes
- No breaking changes in this release
</PackageReleaseNotes>
    <Description>Entity Framework integration for Ajis framework</Description>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ajis/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ajis/dotnet</RepositoryUrl>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconMetadata>icon.png</PackageIconMetadata>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Afrowave.AJIS.Core\Afrowave.AJIS.Core.csproj" />
    <ProjectReference Include="..\src\Afrowave.AJIS.Serialization\Afrowave.AJIS.Serialization.csproj" />
  </ItemGroup>

  <ItemGroup>

    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" />
    <None Include="Assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
