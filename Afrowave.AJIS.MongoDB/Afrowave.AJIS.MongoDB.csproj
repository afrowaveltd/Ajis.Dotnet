<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Afrowave.AJIS.MongoDB</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ajis</Authors>
    <Description>MongoDB integration for Ajis framework</Description>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ajis/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ajis/dotnet</RepositoryUrl>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Afrowave.AJIS.Core\Afrowave.AJIS.Core.csproj" />
    <ProjectReference Include="..\src\Afrowave.AJIS.Serialization\Afrowave.AJIS.Serialization.csproj" />
  </ItemGroup>

  <ItemGroup>

    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
